{
    "name": "cocoya",
    "displayName": "Cocoya: Code, Compute, Yield AI",
    "description": "Visual Python programming for AI and Hardware education",
    "version": "0.8.2",
    "icon": "resources/extension_icon.png",
    "publisher": "simfonia",
    "extensionKind": [
        "ui"
    ],
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Education",
        "Programming Languages"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/simfonia/Cocoya.git"
    },
    "activationEvents": [
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "cocoya.openWorkspace",
                "title": "Cocoya: Open Workspace",
                "category": "Cocoya"
            },
            {
                "command": "cocoya.setPythonPath",
                "title": "Cocoya: Set Python Path",
                "category": "Cocoya"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "cocoya.openWorkspace",
                    "group": "navigation",
                    "when": "resourceExtname == .xml"
                }
            ]
        }
    },
    "scripts": {
        "dev": "npm run dev --prefix ui",
        "build": "npm run build --prefix ui",
        "tauri": "tauri",
        "build:slides": "docs\\teaching\\py_ai_train_run\\build\\build_all.cmd",
        "build:slides:force": "docs\\teaching\\py_ai_train_run\\build\\build_all.cmd --force",
    "pristine:examples": "node scripts/sync_pristine_examples.cjs",
    "vscode:prepublish": "npm run pristine:examples && npm run compile",
        "compile": "tsc -p ./",
        "compile:all": "tsc -p ./ && npm run build:slides",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src --ext ts",
        "lint:ui": "eslint ui/src ui/test --ext .js,.mjs",
"lint:scripts": "eslint scripts --ext .js,.cjs",
"test:python": "node scripts/pytest-layers.cjs",
        "test": "npm run test:unit && npm run test:ui && npm run test:rust",
        "test:unit": "npm run compile && npm run lint && npm run lint:ui && npm run lint:scripts && npm run eol:check && npm run verify:runtime-paths",
        "verify:runtime-paths": "node scripts/verify-runtime-paths.cjs",
        "test:ui": "npm --prefix ui run test:unit",
        "test:dm": "npm --prefix ui run test:dm",
        "test:core": "npm --prefix ui run test:core",
    "test:theme": "npm --prefix ui run test:theme",
        "test:fast": "node scripts/test-related.cjs",
        "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
        "test:integration": "node scripts/run-integration.cjs",
        "coverage": "node scripts/coverage.cjs",
        "coverage:check": "node scripts/coverage.cjs --check",
        "eol:check": "node scripts/eol.cjs",
        "eol:fix": "node scripts/eol.cjs --fix",
        "eol:list": "node scripts/eol.cjs --list"
    },
    "devDependencies": {
        "@types/node": "16.x",
        "@types/vscode": "^1.75.0",
        "@typescript-eslint/eslint-plugin": "^5.45.0",
        "@typescript-eslint/parser": "^5.45.0",
        "@vscode/test-electron": "^2.2.0",
        "c8": "^12.0.0",
        "eslint": "^8.28.0",
        "typescript": "^4.9.4"
    }
}
