#!/usr/bin/env sh
# .husky/pre-commit — 提交前的快速守門
#
# 【設計原則：只擋「機械性」問題，不擋需要思考的問題】
#
# 擋（毫秒級、必然是錯誤）：
#   - 行尾不一致（CRLF/LF 混雜）—— 本專案最常見的無謂 diff 來源
#   - 新增裸 'temp_scripts' 字面值（必須走 src/runtimePaths.ts）
#   - Python 測試忘了加 slow marker
#
# 不擋（留給 CI）：
#   - 完整測試、lint、型別檢查 —— 本機跑得到的都能在 CI 跑，
#     放進 pre-commit 只會讓人習慣用 --no-verify 繞過，反而架空守門。
#
# 【逃生門】
# `git commit --no-verify` 可跳過。刻意保留：hook 不該變成無法工作的瓶頸。

echo "[pre-commit] 檢查行尾…"
node scripts/eol.cjs --check || {
    echo "[pre-commit] 行尾不一致。執行 'npm run eol:fix' 後再提交。"
    exit 1
}

echo "[pre-commit] 檢查產品執行時路徑 SSOT…"
node scripts/verify-runtime-paths.cjs || exit 1

echo "[pre-commit] 檢查 Python 測試是否需要 slow marker…"
node -e '
const fs = require("fs"), path = require("path");
const dir = "tests/e2e";
/*
 * 判準是「subprocess 且執行訓練腳本」，不是「有 subprocess」。
 *
 * ⚠️ 過度寬泛的教訓（2026-10-04 實測）：初版只看 subprocess，結果
 *   test_export_dataset.py / test_export_live_layout.py 被誤判 —— 但它們跑的是
 *   sidecar 匯出（非訓練），實測僅 0.53s / 0.65s。
 *   掃描型守門過度寬泛會逼人無聲放寬斷言，等於沒有守門（AGENTS.md 紀律）。
 *
 * 對照實測耗時：
 *   subproc + _train.py -> 6.8s / 11.8s / 40.6s  確實 slow
 *   subproc only        -> 0.53s / 0.65s          誤判來源
 *   _train.py only      -> 1.64s（只讀檔檢查）
 */
const off = [];
for (const f of fs.readdirSync(dir).filter((x) => x.endsWith(".py"))) {
    const src = fs.readFileSync(path.join(dir, f), "utf8");
    const runsTraining = /subprocess|Popen/.test(src) && /_train\.py/.test(src);
    const marked = /@pytest\.mark\.slow/.test(src);
    if (runsTraining && !marked) off.push(f);
}
if (off.length) {
    console.error("[pre-commit] 以下測試會執行真實訓練但未標 slow marker，會拖慢預設路徑：");
    off.forEach((f) => console.error("   " + f));
    console.error("   請加上：@pytest.mark.slow");
    process.exit(1);
}
' || exit 1

echo "[pre-commit] 檢查 Python 測試依賴是否已宣告…"
node -e '
const fs = require("fs"), path = require("path");
/*
 * 首次上 CI 的教訓（2026-10-04）：Tier 1 三個測試失敗，
 * 逐一查證後才發現是「requirements-dev.txt 漏了套件」：
 *   - sklearn        -> training_loop.py 頂層 import
 *   - cv2 / paramiko -> dataset_sidecar.py 頂層 import（sidecar 啟動失敗，
 *                       症狀卻是 JSONDecodeError，與病因完全無關）
 *
 * 本守門比對「測試**直接** import 的第三方套件」與「requirements 已宣告者」，
 * 讓漏宣告在 commit 前就暴露，而不是等 CI。
 *
 * ⚠️ **已知盲點（實測確認，勿以為它能擋全部）**：
 *   它**只看測試檔案自己的 import**，看不到「透過 subprocess 啟動的腳本
 *   所需依賴」。實例：scikit-learn 是 training_loop.py（訓練模板）需要的，
 *   但 test_detector_curves.py 並未 import 它 —— 移除 requirements 裡的
 *   scikit-learn，本守門仍然放行（mutation 驗證）。
 *
 *   換言之：**本守門只保證「直接依賴」，間接依賴仍需靠 CI 或人工察覺。**
 *   這也是為什麼它不能取代 CI，而是 CI 的前置篩選（省下 1-2 分鐘來回）。
 *
 * 已能攔到的實例：matplotlib（test_detector_curves.py 直接 import）——
 *   首次上 CI 時我漏了它，是本守門在 commit 前就抓出來的。
 */
const STD = new Set(["json","os","sys","io","csv","re","time","tempfile","shutil",
    "subprocess","zipfile","pathlib","base64","hashlib","contextlib","random","math",
    "struct","typing","collections","itertools","functools","shlex","uuid","platform",
    "importlib","inspect","traceback","textwrap","copy","warnings","abc","enum","glob",
    "stat","fnmatch","threading","datetime","pickle","unittest","argparse","logging",
    "dataclasses","numbers","string","socket","ssl","http","urllib","email","xml",
    "sqlite3","csv","gzip","bz2","lzma","calendar","decimal","fractions","heapq",
    "array","bisect","operator","reprlib","types","unicodedata","zlib","getpass",
    "webbrowser","pprint","filecmp","fileinput","linecache","tokenize","trace","gc",
    "atexit","signal","errno","locale","site","sysconfig","distutils","pkgutil",
    "ast","io"]);
const KNOWN_IGNORE = new Set(["common","camera_service","remote_tflite","local_training",
    "remote_ssh","dataset_io","media_pipe_service","training_loop","classifier_dataset",
    "detector_dataset","line_dataset","table_dataset","feature_dataset","cocoya_shared",
    "image_formats"]);

const req = fs.readFileSync("requirements-dev.txt", "utf8");
const declared = new Set();
// pip 名稱與 import 名稱不同者需對照（cv2 -> opencv-python 等）
const ALIAS = { cv2: "opencv-python", PIL: "pillow", PILImage: "pillow", sklearn: "scikit-learn",
    skimage: "scikit-image", yaml: "pyyaml", Crypto: "pycryptodome", dateutil: "python-dateutil",
    dotenv: "python-dotenv", serial: "pyserial", usb: "pyusb" };

const dir = "tests/e2e";
const missing = new Map();
const scan = (d) => {
    for (const e of fs.readdirSync(d, { withFileTypes: true })) {
        const full = path.join(d, e.name);
        if (e.isDirectory()) { scan(full); continue; }
        if (!e.name.endsWith(".py")) continue;
        const src = fs.readFileSync(full, "utf8");
        for (const m of src.matchAll(/^\s*(?:import|from)\s+([A-Za-z_][\w]*)/gm)) {
            const mod = m[1];
            if (STD.has(mod) || KNOWN_IGNORE.has(mod)) continue;
            const pkg = ALIAS[mod] || mod;
            if (!req.toLowerCase().includes(pkg.toLowerCase().split("-")[0])) {
                if (!missing.has(mod)) missing.set(mod, []);
                missing.get(mod).push(path.relative(".", full));
            }
        }
    }
};
scan(dir);
if (missing.size) {
    console.error("[pre-commit] 測試 import 了未宣告於 requirements-dev.txt 的套件：");
    for (const [m, files] of missing) console.error(`   ${m}  (${files[0]})`);
    console.error("   若確為專案內本地模組，請加進腳本的 KNOWN_IGNORE；");
    console.error("   若確為第三方套件，請加進 requirements-dev.txt。");
    process.exit(1);
}
' || exit 1

echo "[pre-commit] 檢查 Python 子進程的 UTF-8 鐵律…"
node -e '
const fs = require("fs"), path = require("path");
/*
 * AGENTS.md「Python 子進程編碼鐵律」第 (2) 項：Host 啟動 Python 必帶
 *   PYTHONIOENCODING / PYTHONUTF8。
 *
 * 為何需要守門：CI 首次執行時 huskylens_protocol.test.mjs 在 GitHub runner 上
 * UnicodeEncodeError 失敗（runner 是 cp1252）。原因是只寫了 encoding:utf8 ——
 * 那只管 Node **讀取**時的解碼，**管不到 Python 寫出時**的編碼。
 *
 * 實測：本專案當時 5 處 spawn Python **全部漏帶**，故立此守門。
 */
const targets = [];
const walk = (d, filter) => {
    if (!fs.existsSync(d)) return;
    for (const e of fs.readdirSync(d, { withFileTypes: true })) {
        const full = path.join(d, e.name);
        if (e.isDirectory()) {
            if (!["node_modules", "coverage", "temp", "target"].includes(e.name)) walk(full, filter);
        } else if (filter(e.name)) targets.push(full);
    }
};
walk("ui/src", (n) => n.endsWith(".test.mjs"));
walk("scripts", (n) => n.endsWith(".cjs"));

/*
 * ⚠️ 掃描時必須**排除註解行** —— 初版用整檔 includes("PYTHONIOENCODING")
 *   判斷，結果自己寫的說明註解裡出現了這個字就讓守門永遠放行
 *   （mutation 驗證時才發現）。
 *   同理，比對範圍限「spawn 呼叫所在行 + 後續 6 行」，
 *   避免檔案其他地方碰巧提到就整檔豁免。
 */
const offenders = [];
for (const f of targets) {
    const lines = fs.readFileSync(f, "utf8").split("\n");
    for (let i = 0; i < lines.length; i++) {
        const line = lines[i];
        const code = line.replace(/\/\/.*$/, "");          // 去掉行註解
        if (!/spawnSync\s*\(|spawn\s*\(/.test(code)) continue;
        if (!/\bpy\b|python|\bPY\b|exe\b|pythonExe/.test(code)) continue;
        // 看 spawn 之後 6 行是否有帶 env（多行寫法的 env 在下一行）
        const window = lines.slice(i, i + 7)
            .map((l) => l.replace(/\/\/.*$/, "")).join("\n");
        if (/PYTHONIOENCODING/.test(window)) continue;
        offenders.push(f + ":" + (i + 1) + "  " + code.trim().slice(0, 66));
    }
}
if (offenders.length) {
    console.error("[pre-commit] 啟動 Python 未帶 PYTHONIOENCODING/PYTHONUTF8：");
    offenders.forEach((o) => console.error("   " + o));
    console.error("   需補： env: { ...process.env, PYTHONIOENCODING: \x27utf-8\x27, PYTHONUTF8: \x271\x27 }");
    console.error("   理由：encoding 只管讀取端；Python 寫出端在 Windows 上預設是系統 ANSI 編碼。");
    process.exit(1);
}
' || exit 1

echo "[pre-commit] 通過"