{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "globals": {
    "Blockly": "readonly",
    "CocoyaLoader": "readonly",
    "CocoyaUtils": "readonly",
    "CocoyaMediaUri": "readonly",
    "CocoyaBoard": "readonly",
    "CocoyaSettings": "readonly",
    "CocoyaPyHighlight": "readonly",
    "CocoyaTextEditor": "readonly",
    "CocoyaTextMode": "readonly",
    "acquireVsCodeApi": "readonly",
    "hljs": "readonly"
  },
  "extends": ["eslint:recommended"],
  "ignorePatterns": ["*.min.js"],
  "overrides": [
    {
      "files": [
        "src/**/*.test.mjs",
        "src/**/*.mjs",
        "test/**/*.js",
        "test/**/*.mjs"
      ],
      "env": { "node": true }
    }
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "no-control-regex": "off",
    "no-regex-spaces": "off",
    "no-empty": "off"
  }
}
