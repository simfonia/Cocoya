<category name="%{BKY_CAT_HUSKYLENS}" colour="%{BKY_COLOUR_HUSKYLENS}">
    <label text="%{BKY_HUSKY_LBL_SETUP}" gap="16"></label>
    <block type="mcu_huskylens_init"></block>
    <block type="mcu_huskylens_set_algorithm"></block>

    <label text="%{BKY_HUSKY_LBL_LINE}" gap="16"></label>
    <block type="mcu_huskylens_any_arrow" gap="16"></block>
    <block type="mcu_huskylens_get_arrow">
        <value name="ID">
            <shadow type="math_number">
                <field name="NUM">1</field>
            </shadow>
        </value>
    </block>

    <label text="%{BKY_HUSKY_LBL_DETECT}" gap="16"></label>
    <block type="mcu_huskylens_request" gap="16"></block>
    <block type="mcu_huskylens_get_box">
        <value name="ID">
            <shadow type="math_number">
                <field name="NUM">1</field>
            </shadow>
        </value>
    </block>
    <block type="mcu_huskylens_is_detected">
        <value name="ID">
            <shadow type="math_number">
                <field name="NUM">1</field>
            </shadow>
        </value>
    </block>
    <block type="mcu_huskylens_count"></block>
    <block type="mcu_huskylens_get_id_at">
        <value name="N">
            <shadow type="math_number">
                <field name="NUM">0</field>
            </shadow>
        </value>
    </block>

    <label text="%{BKY_HUSKY_LBL_CLASSIFY}" gap="16"></label>
    <block type="mcu_huskylens_get_name">
        <value name="ID">
            <shadow type="math_number">
                <field name="NUM">1</field>
            </shadow>
        </value>
    </block>
    <block type="mcu_huskylens_set_name"></block>

    <label text="%{BKY_HUSKY_LBL_LEARN}" gap="32"></label>
    <block type="mcu_huskylens_learn"></block>
    <block type="mcu_huskylens_forget"></block>
    <block type="mcu_huskylens_save_knowledge"></block>
    <block type="mcu_huskylens_load_knowledge" gap="32"></block>
</category>
